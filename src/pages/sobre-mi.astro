---
import Layout from "../layouts/Layout.astro";
import Contact from "../components/Contact.astro";

const technologies = [
    {
        title: "Frontend",
        items: ["React", "Next.js", "JavaScript"],
    },
    {
        title: "Backend",
        items: ["Java", "PHP", "Python", "FastAPI", "CodeIgniter", "Laravel"],
    },
    {
        title: "Escritorio",
        items: ["C++", "Qt"],
    },
    {
        title: "Desarrollo móvil",
        items: ["Swift", "Flutter", "Kotlin"],
    },
];
---

<Layout
    title="Sobre mí — Narcis Aducovschi"
    description="Conoce a Narcis Aducovschi, desarrollador Full Stack en búsqueda de una oportunidad para aportar y seguir aprendiendo."
>
    <section class="hero container" aria-labelledby="about-title">
        <p class="eyebrow">UN POCO SOBRE MÍ</p>

        <h1 id="about-title">
            Curiosidad para entender.
            <span>
                Código para <em class="accent">crear.</em>
            </span>
        </h1>
    </section>

    <section class="presentation container" aria-labelledby="name-title">
        <div class="portrait">
            <img src="/images/yo.webp" alt="Retrato de Narcis Aducovschi" />
        </div>

        <div class="presentation-content">
            <h2 id="name-title">Narcis Aducovschi</h2>
            <p class="role">Desarrollador Full Stack</p>

            <p class="description">
                Me interesa entender cómo funcionan las cosas y convertir ideas
                en experiencias digitales.
            </p>

            <p class="description">
                Durante mis prácticas en SEIDOR desarrollé una aplicación CRUD
                en un entorno IBM i, trabajando con RPG, SQL, DB2 y SDA.
            </p>

            <a class="text-link" href="/#experiencia">
                Mi experiencia
            </a>
        </div>
    </section>

    <section class="tools container" aria-labelledby="tools-title">
        <h2 id="tools-title">Mis tecnologías</h2>

        <div class="tools-grid">
            {technologies.map((group) => (
                <div class="tools-group">
                    <h3>{group.title}</h3>

                    <ul class="tags">
                        {group.items.map((technology) => (
                            <li>{technology}</li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </section>

    <section class="next-step container" aria-labelledby="next-title">
        <div>
            <h2 id="next-title">
                Seguir creciendo, <em class="accent">en equipo.</em>
            </h2>

            <p>
                Busco una oportunidad como desarrollador Full Stack donde
                aportar lo que sé, aprender de otros y participar en proyectos
                reales.
            </p>
        </div>
    </section>
    <Contact />
</Layout>

<style>
    section[id] {
        scroll-margin-top: 32px;
    }

    /* Cabecera de la página */

    .hero {
        padding-block: 72px 56px;
    }

    .eyebrow {
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 3px;
    }

    h1 {
        margin-top: 24px;
        font-size: clamp(40px, 6.2vw, 80px);
        font-weight: 700;
        line-height: 1.08;
        letter-spacing: -0.055em;
        overflow-wrap: anywhere;
    }

    h1 > span {
        display: block;
    }

    h2 {
        font-size: clamp(28px, 3.5vw, 42px);
        font-weight: 600;
        line-height: 1.15;
        letter-spacing: -0.04em;
    }

    /* Presentación */

    .presentation {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        align-items: center;
        gap: 48px;
        padding-block: 48px 64px;
        border-top: 1px solid var(--color-border);
    }

    .portrait {
        position: relative;
        width: 100%;
        max-width: 400px;
        justify-self: center;
    }

    .portrait img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 20px;
    }

    .photo-symbol {
        position: absolute;
        top: -20px;
        right: -12px;
        color: var(--color-purple);
        font-size: 80px;
        line-height: 1;
        pointer-events: none;
    }

    .presentation-content {
        min-width: 0;
    }

    .presentation-content h2 {
        margin-top: 16px;
        overflow-wrap: anywhere;
    }

    .role {
        margin-top: 8px;
        font-size: 20px;
    }

    .description {
        max-width: 60ch;
        margin-top: 20px;
        color: var(--color-muted);
        font-size: 15px;
        line-height: 1.8;
    }

    .text-link {
        display: inline-block;
        margin-top: 24px;
        border-bottom: 1px solid var(--color-purple);
        padding-bottom: 4px;
        font-size: 14px;
    }

    .text-link:hover {
        color: var(--color-purple);
    }

    .text-link span {
        margin-left: 12px;
        color: var(--color-purple);
    }

    /* Tecnologías */

    .tools {
        padding-block: 48px 56px;
        border-top: 1px solid var(--color-border);
    }

    .tools-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 28px;
        margin-top: 32px;
    }

    .tools-group {
        min-width: 0;
        border-top: 1px solid var(--color-border);
        padding-top: 20px;
    }

    .tools-group h3 {
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -0.025em;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 16px 0 0;
        padding: 0;
        list-style: none;
    }

    .tags li {
        border: 1px solid var(--color-border);
        border-radius: 999px;
        padding: 5px 12px;
        font-size: 12px;
    }

    /* Siguiente paso */

    .next-step {
        padding-block: 40px 48px;
        border-top: 1px solid var(--color-border);
    }

    .next-step p {
        max-width: 50ch;
        margin-top: 20px;
        font-size: 18px;
        color: var(--color-muted);
    }

    /* Contacto */

    .contact {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 32px;
        border-top: 1px solid var(--color-border);
        padding-block: 40px 48px;
    }

    .contact h2 {
        font-size: clamp(40px, 5vw, 64px);
    }

    .contact p {
        font-size: 14px;
    }

    .contact .contact-note {
        margin-top: 6px;
        color: var(--color-muted);
        font-size: 12px;
    }

    /* Móvil */

    @media (max-width: 700px) {
        .hero {
            padding-block: 48px 36px;
        }

        .eyebrow {
            font-size: 9px;
            letter-spacing: 2px;
        }

        .presentation {
            grid-template-columns: 1fr;
            gap: 32px;
            padding-block: 40px;
        }

        .portrait {
            max-width: 320px;
        }

        .photo-symbol {
            top: -16px;
            right: -8px;
            font-size: 64px;
        }

        .role {
            font-size: 18px;
        }

        .description {
            font-size: 14px;
        }

        .tools {
            padding-block: 32px 40px;
        }

        .tools-grid {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .next-step {
            padding-block: 32px 40px;
        }

        .next-step p {
            font-size: 15px;
        }

        .contact {
            align-items: flex-start;
            flex-direction: column;
            gap: 20px;
            padding-block: 32px 40px;
        }
    }
</style>
