---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Portfolio de Narcis Aducovschi, desarrollador Full Stack.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <Header />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  main {
    flex: 1;
  }

  .skip-link {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    padding: 10px 16px;
    background: var(--color-text);
    color: var(--color-background);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>